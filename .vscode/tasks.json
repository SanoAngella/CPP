{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "Build DSA Calculator GUI",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-O2",
                "src\\main.cpp",
                "src\\ui\\MainWindow.cpp",
                "src\\dsa\\HistoryList.cpp",
                "src\\core\\ExpressionParser.cpp",
                "src\\core\\Calculator.cpp",
                "-Isrc",
                "-o",
                "calculator.exe",
                "-mwindows",
                "-lgdi32",
                "-lcomctl32"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\assignments\\calculator\\assignment"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles the native Windows desktop calculator GUI."
        },
        {
            "type": "shell",
            "label": "Build and Run Calculator Tests",
            "command": "cmd",
            "args": [
                "/c",
                "C:\\MinGW\\bin\\g++.exe -std=c++17 -O2 tests\\test_calculator.cpp src\\dsa\\HistoryList.cpp src\\core\\ExpressionParser.cpp src\\core\\Calculator.cpp -Isrc -o run_tests.exe && run_tests.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\assignments\\calculator\\assignment"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "detail": "Compiles and executes the DSA test suite."
        },
        {
            "type": "shell",
            "label": "Build Word Guess Game GUI",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-O2",
                "GUI.cpp",
                "WordGame.cpp",
                "GuessList.cpp",
                "-o",
                "wordguess.exe",
                "-mwindows",
                "-lgdi32"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\assignments\\WordGuess"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Compiles the native Windows desktop Word Guess GUI."
        },
        {
            "type": "shell",
            "label": "Build Word Guess Console",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-O2",
                "main.cpp",
                "WordGame.cpp",
                "GuessList.cpp",
                "-o",
                "wordguess_cli.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\assignments\\WordGuess"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Compiles the CLI version of Word Guess."
        }
    ],
    "version": "2.0.0"
}